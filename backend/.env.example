# ============================================
# Kafeh Booking — CodeIgniter 3 .env example
# ============================================

# --- Database ---
database.default.hostname = localhost
database.default.database = kafeh
database.default.username = root
database.default.password =
database.default.dbdriver = mysqli
database.default.port     = 3306

# --- PayPal (Orders v2 REST API, redirect checkout) ---
# Get sandbox Client ID / Secret at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENV=sandbox
